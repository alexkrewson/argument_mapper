{
  "name": "vite_scaffold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "cross-env BUILD_TARGET=mobile vite build",
    "sync:android": "npm run build:mobile && npx cap sync android",
    "build:apk": "npm run sync:android && node scripts/gradlew.mjs assembleDebug",
    "build:apk:release": "npm run sync:android && node scripts/gradlew.mjs assembleRelease",
    "build:aab:release": "npm run sync:android && node scripts/gradlew.mjs bundleRelease",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test --grep-invert @costly",
    "test:e2e:full": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:apk": "node --test tests/apk/apk-static.test.mjs",
    "test:apk:device": "node --test tests/apk/apk-device.test.mjs",
    "test:apk:flows": "node --test tests/apk/apk-flows.test.mjs",
    "test:apk:turns": "node --test tests/apk/apk-turns.test.mjs",
    "test:apk:settings": "node --test tests/apk/apk-settings.test.mjs",
    "test:apk:costly": "cross-env RUN_COSTLY=1 node --test tests/apk/apk-costly.test.mjs",
    "pretest:apk:all": "node -e \"const fs=require('fs');fs.rmSync('test-results/apk',{recursive:true,force:true});fs.mkdirSync('test-results/apk',{recursive:true})\"",
    "test:apk:all": "node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/apk/support/json-reporter.mjs --test-reporter-destination=test-results/apk/results.json tests/apk/apk-static.test.mjs tests/apk/apk-device.test.mjs tests/apk/apk-flows.test.mjs tests/apk/apk-turns.test.mjs tests/apk/apk-settings.test.mjs",
    "test:apk:report": "node tests/apk/support/report.mjs",
    "validate:apk": "npm run build:apk && npm run test:apk:all && npm run test:apk:report",
    "version:bump": "node scripts/bump-version.mjs",
    "release:aab": "npm run version:bump && npm run build:aab:release",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=idisagree --branch=master",
    "deploy:verify": "node scripts/verify-deploy.mjs",
    "ship": "npm run deploy && npm run deploy:verify && npm run build:apk",
    "report": "node scripts/build-test-report.mjs",
    "test:web": "playwright test --grep-invert @costly",
    "test:web:costly": "playwright test --grep @costly",
    "test:web:judgement": "playwright test --grep @judgement",
    "test:web:concession": "playwright test --grep @concession"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/device": "^8.0.2",
    "@sentry/capacitor": "^4.2.0",
    "@sentry/react": "10.60.0",
    "@supabase/supabase-js": "^2.99.1",
    "cytoscape": "^3.34.1",
    "cytoscape-dagre": "^2.5.0",
    "cytoscape-node-html-label": "^1.2.2",
    "react": "^19.2.0",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "adm-zip": "^0.6.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "vite": "^8.2.0",
    "wrangler": "^4.116.0"
  }
}
