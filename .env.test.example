# Copy to .env.test and fill in. Loaded by playwright.config.js.
# .env.test is gitignored — never commit real credentials.

# Account the Playwright suite signs in as. Use a dedicated test account,
# not your personal one: the suite creates and deletes saved arguments.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Optional. Defaults to https://idisagree.trolleysolution.com when unset.
# Point at a local dev server with: TEST_BASE_URL=http://localhost:5173
# TEST_BASE_URL=
